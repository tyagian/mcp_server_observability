{
  "uid": "mcp-server-monitoring",
  "title": "MCP Server Observability",
  "description": "Comprehensive observability for MCP servers: transport, protocol, tool execution, agentic metrics, sessions, resources, and system health. Supports multi-client monitoring.",
  "tags": ["mcp", "monitoring", "observability", "opentelemetry", "multi-client"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "client_id",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(mcp_tool_calls_total, client_id)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      },
      {
        "name": "tool_name",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(mcp_tool_calls_total, tool_name)",
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "refresh": 2
      }
    ]
  },
  "panels": [
    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "id": 200, "title": "🔑 Overview (Multi-Client)", "type": "row" },
    {
      "id": 10, "title": "Total Tool Calls", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(mcp_tool_calls_total{client_id=~\"$client_id\"})", "legendFormat": "Total" }]
    },
    {
      "id": 11, "title": "Total Errors", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(mcp_tool_calls_total{status=\"error\", client_id=~\"$client_id\"})", "legendFormat": "Errors" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } }, "overrides": [] }
    },
    {
      "id": 12, "title": "Error Rate", "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(mcp_tool_calls_total{status=\"error\", client_id=~\"$client_id\"}[5m])) / sum(rate(mcp_tool_calls_total{client_id=~\"$client_id\"}[5m]))", "legendFormat": "Error Rate" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.1 }] } }, "overrides": [] }
    },
    {
      "id": 13, "title": "Active Sessions", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "mcp_active_sessions", "legendFormat": "Sessions" }]
    },
    {
      "id": 14, "title": "In-Flight Calls", "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "mcp_tool_inflight_total", "legendFormat": "In-Flight" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] } }, "overrides": [] }
    },
    {
      "id": 15, "title": "Handshake Success Rate", "type": "gauge",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(mcp_handshake_total{status=\"success\"}) / sum(mcp_handshake_total)", "legendFormat": "Handshake %" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.95 }, { "color": "green", "value": 0.99 }] } }, "overrides": [] }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "id": 201, "title": "👥 Multi-Client Breakdown", "type": "row" },
    {
      "id": 16, "title": "Tool Calls by Client", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(mcp_tool_calls_total[1m])) by (client_id)", "legendFormat": "{{client_id}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 17, "title": "Active Sessions by Client", "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "mcp_active_sessions_by_client", "legendFormat": "{{client_id}}" }],
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "id": 202, "title": "🔌 Transport Layer", "type": "row" },
    {
      "id": 18, "title": "Connections by Transport Type", "type": "piechart",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 15 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(mcp_connection_total) by (transport)", "legendFormat": "{{transport}}" }]
    },
    {
      "id": 19, "title": "Reconnection Events", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 15 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(mcp_reconnection_total[5m])) by (client_id)", "legendFormat": "{{client_id}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 20, "title": "Handshake Success/Failure", "type": "timeseries",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 15 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(rate(mcp_handshake_total{status=\"success\"}[5m]))", "legendFormat": "Success" },
        { "expr": "sum(rate(mcp_handshake_total{status=\"failure\"}[5m]))", "legendFormat": "Failure" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "id": 203, "title": "📨 Protocol & Messages", "type": "row" },
    {
      "id": 21, "title": "Messages Received by Type", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(mcp_messages_received_total{client_id=~\"$client_id\"}[1m])) by (msg_type)", "legendFormat": "{{msg_type}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 22, "title": "Message Latency (p50/p95/p99)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(mcp_message_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p99" },
        { "expr": "histogram_quantile(0.95, sum(rate(mcp_message_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.50, sum(rate(mcp_message_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 23, "title": "JSON-RPC Errors by Code", "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 32 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(mcp_jsonrpc_errors_total[5m])) by (error_code, error_message)", "legendFormat": "{{error_code}}: {{error_message}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 24, "title": "Protocol Version Distribution", "type": "barchart",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 32 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(mcp_protocol_version_count) by (version, client_id)", "legendFormat": "{{version}} ({{client_id}})" }]
    },
    {
      "id": 25, "title": "Message Size Distribution", "type": "bargauge",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 38 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(mcp_message_size_bytes_bucket{direction=\"received\"}[5m])) by (le))", "legendFormat": "Received p95" },
        { "expr": "histogram_quantile(0.95, sum(rate(mcp_message_size_bytes_bucket{direction=\"sent\"}[5m])) by (le))", "legendFormat": "Sent p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 44 }, "id": 204, "title": "⚡ Tool Execution", "type": "row" },
    {
      "id": 1, "title": "Tool Invocation Rate", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 45 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(mcp_tool_calls_total{client_id=~\"$client_id\", tool_name=~\"$tool_name\"}[1m])) by (tool_name)", "legendFormat": "{{tool_name}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 2, "title": "Tool Execution Time (p50/p95/p99)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 45 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(mcp_tool_duration_seconds_bucket{tool_name=~\"$tool_name\"}[5m])) by (tool_name, le))", "legendFormat": "{{tool_name}} p99" },
        { "expr": "histogram_quantile(0.95, sum(rate(mcp_tool_duration_seconds_bucket{tool_name=~\"$tool_name\"}[5m])) by (tool_name, le))", "legendFormat": "{{tool_name}} p95" },
        { "expr": "histogram_quantile(0.50, sum(rate(mcp_tool_duration_seconds_bucket{tool_name=~\"$tool_name\"}[5m])) by (tool_name, le))", "legendFormat": "{{tool_name}} p50" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 3, "title": "Success vs Error Rate by Tool", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 53 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(rate(mcp_tool_calls_total{status=\"success\", tool_name=~\"$tool_name\"}[1m])) by (tool_name)", "legendFormat": "{{tool_name}} ✓" },
        { "expr": "sum(rate(mcp_tool_calls_total{status=\"error\", tool_name=~\"$tool_name\"}[1m])) by (tool_name)", "legendFormat": "{{tool_name}} ✗" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 4, "title": "Error Distribution by Type", "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 53 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(mcp_tool_errors_total{tool_name=~\"$tool_name\"}) by (error_type)", "legendFormat": "{{error_type}}" }]
    },
    {
      "id": 5, "title": "Concurrent In-Flight Calls", "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 61 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "mcp_tool_inflight{tool_name=~\"$tool_name\"}", "legendFormat": "{{tool_name}}" },
        { "expr": "mcp_tool_inflight_total", "legendFormat": "TOTAL" }
      ],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 }] } }, "overrides": [] }
    },
    {
      "id": 6, "title": "Tool Result Size (p95)", "type": "bargauge",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 61 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(mcp_tool_result_size_bytes_bucket{tool_name=~\"$tool_name\"}[5m])) by (tool_name, le))", "legendFormat": "{{tool_name}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 67 }, "id": 205, "title": "🤖 Agentic & Token Metrics", "type": "row" },
    {
      "id": 50, "title": "Token Usage by Tool (Input vs Output)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 68 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "sum(rate(mcp_token_usage_total{direction=\"input\", tool_name=~\"$tool_name\"}[5m])) by (tool_name)", "legendFormat": "{{tool_name}} input" },
        { "expr": "sum(rate(mcp_token_usage_total{direction=\"output\", tool_name=~\"$tool_name\"}[5m])) by (tool_name)", "legendFormat": "{{tool_name}} output" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 51, "title": "Token per Call Distribution (p95)", "type": "bargauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 68 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(mcp_token_usage_per_call_bucket{tool_name=~\"$tool_name\"}[5m])) by (tool_name, le))", "legendFormat": "{{tool_name}}" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true }
    },
    {
      "id": 52, "title": "Tool Hallucination Rate", "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 76 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(mcp_tool_hallucination_total[5m])) by (attempted_tool, client_id)", "legendFormat": "{{attempted_tool}} ({{client_id}})" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 53, "title": "Prompt Template Usage", "type": "timeseries",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 76 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(mcp_prompt_template_usage_total[5m])) by (prompt_name)", "legendFormat": "{{prompt_name}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 54, "title": "Self-Correction Rate", "type": "gauge",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 76 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(mcp_self_correction_total{status=\"recovered\"}) / sum(mcp_self_correction_total)", "legendFormat": "Recovery Rate" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.5 }, { "color": "green", "value": 0.7 }] } }, "overrides": [] }
    },
    {
      "id": 55, "title": "Turns to Completion", "type": "histogram",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 82 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(mcp_turns_to_completion_bucket[5m])) by (le)", "legendFormat": "≤ {{le}} turns", "format": "heatmap" }]
    },
    {
      "id": 56, "title": "Task Success Rate", "type": "gauge",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 82 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(mcp_task_success_total{status=\"success\"}) / sum(mcp_task_success_total)", "legendFormat": "TSR" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "green", "value": 0.85 }] } }, "overrides": [] }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 88 }, "id": 206, "title": "🚦 Rate Limiting & Throttling", "type": "row" },
    {
      "id": 60, "title": "Rate Limit Events", "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 89 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(mcp_rate_limit_total[5m])) by (client_id, tool_name)", "legendFormat": "{{client_id}} → {{tool_name}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 61, "title": "Currently Rate-Limited Clients", "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 89 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "mcp_rate_limit_active", "legendFormat": "Rate-Limited" }],
      "fieldConfig": { "defaults": { "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 }] } }, "overrides": [] }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 95 }, "id": 207, "title": "📁 Resource Access", "type": "row" },
    {
      "id": 30, "title": "Top Accessed Resources", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 96 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "topk(5, sum(rate(mcp_resource_accessed_total{client_id=~\"$client_id\"}[5m])) by (resource))", "legendFormat": "{{resource}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
      "id": 31, "title": "Resource Size (p95)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 96 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(mcp_resource_size_bytes_bucket[5m])) by (resource, le))", "legendFormat": "{{resource}}" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    },
    {
      "id": 32, "title": "Resource Error Rate", "type": "gauge",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 104 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(mcp_resource_errors_total[5m])) / sum(rate(mcp_resource_accessed_total[5m]))", "legendFormat": "Error Rate" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.1 }] } }, "overrides": [] }
    },
    {
      "id": 33, "title": "Resource Access Anomalies", "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 104 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(mcp_resource_access_anomaly_total[5m])) by (anomaly_type)", "legendFormat": "{{anomaly_type}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 110 }, "id": 208, "title": "🔗 Sessions & Connections", "type": "row" },
    {
      "id": 70, "title": "Session Duration (p50/p95)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 111 },
      "datasource": "Prometheus",
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(mcp_session_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.50, sum(rate(mcp_session_duration_seconds_bucket[5m])) by (le))", "legendFormat": "p50" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 71, "title": "Session Disconnects by Reason", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 111 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(mcp_session_disconnects_total[5m])) by (client_id, reason)", "legendFormat": "{{client_id}} ({{reason}})" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 119 }, "id": 209, "title": "💻 System Resources", "type": "row" },
    {
      "id": 7, "title": "CPU Usage %", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 120 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "mcp_cpu_usage_percent", "legendFormat": "CPU %" }],
      "fieldConfig": { "defaults": { "unit": "percent", "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 70 }, { "color": "red", "value": 90 }] } }, "overrides": [] }
    },
    {
      "id": 8, "title": "Memory Usage (MB)", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 120 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "mcp_memory_usage_mb", "legendFormat": "Memory MB" }],
      "fieldConfig": { "defaults": { "unit": "decmbytes" }, "overrides": [] }
    },

    { "collapsed": false, "gridPos": { "h": 1, "w": 24, "x": 0, "y": 128 }, "id": 210, "title": "🌐 HTTP Layer (Streamable HTTP Transport)", "type": "row" },
    {
      "id": 80, "title": "HTTP Request Rate", "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 129 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "sum(rate(http_requests_total[1m])) by (handler)", "legendFormat": "{{handler}}" }],
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] }
    },
    {
